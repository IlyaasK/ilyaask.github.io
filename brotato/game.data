; =============================================================================
; Brotato: DEMON, Danger 5, ENDLESS (wave 21+) -- the DEFAULT training/eval
; config for this tree.
;
; This is the file `./puffer train` and `./puffer eval` load: src/ini.h:504
; (puf_ini_load_env) reads config/default.ini and then config/<base.env_name>.ini,
; and this env's registered name is "brotato" (PUFFER_ENV_NAME).  The CUDA env,
; the CPU env and the bridge all enter the same profile from the `character` /
; `starting_weapon` keys below (puf_init -> bt_character_id_from_name,
; brotato.h:474).  A MISSING or misspelled `character` resolves to Bull
; (bt_character_id_from_name returns BT_CHARACTER_BULL for NULL/unknown,
; brotato_characters.h:148), so the key is set explicitly and the run smoke below
; is the check -- nothing else in this tree selects a character at run time.
;
; config/brotato_demon_endless.ini is a symlink to this file: one source of
; truth for the Demon endless profile, kept so the tools/docs that name it
; (ocean/brotato/bridge/EVAL.md, migration/HANDOFF.md) still resolve.
;
; STRATEGY (the guide this profile and its shaping follow): ArosRising's "Guide
; to Endless Mode", High Endless section --
;   start Ghost Scepter -> keep ~1 HP early and abuse the HP-priced shop ->
;   combine scepters -> buy economy (Harvesting, Luck, Bag, Crown, Hunting
;   Trophy, Coupon, Dangerous Bunny, Recycling Machine, Lure) -> pivot around
;   wave 25-40 to Pruner / Potato Thrower / Excalibur (+ Alien Eyes, Anvil) ->
;   Spicy Sauce build (Garden + Improved Tools, Explosive Shells + Plastic
;   Explosive, Alien Tongue, Sad Tomato/Torture, Padding, Tardigrade, Silver
;   Bullet, Grind's Magical Leaf, Vigilante Ring, Bloody Hand) -> lock the shop
;   and bank materials late.
;   Demon converts 50% of its gold into +1 Max HP per 13-gold chunk at every
;   wave end (brotato_character_runtime.h bt_character_convert_end_of_wave), and
;   its SHOP CURRENCY is Max HP, not gold (run_data.gd:1428-1439) -- materials
;   are Max HP one wave later.
;
; WHAT THE AGENT OPTIMISES (task vs. shaping)
;   Objective.  A run's record is the deepest wave reached: ProgressData's
;   DifficultyScore (difficulty + wave; run_data.gd:1819, main.gd:944) and, past
;   wave 20, max_endless_wave_beaten.  Log.perf reports that wave, so [sweep]
;   metric = perf selects on the task itself (default.ini's metric = score would
;   rank runs by KILLS).
;   Step reward: the game's own signal, ALWAYS applied (brotato_state.h:562-568)
;   R_KILL 1.0, R_HERD 0.15, R_DMG -0.08, R_REGEN 0.002, R_WAVE 8.0, R_WIN 50.0,
;   R_DEATH -5.0.  The shaping below is an ADDITION to that stream, never a
;   replacement for it: kills, damage taken, regen, wave clears, the win and
;   death still pay exactly what they pay with every rw_* weight at 0.
;   Shaping (credit assignment only).  F(s,s') = gamma*Phi(s') - Phi(s)
;   (Ng, Harada & Russell 1999; ocean/brotato/brotato_reward.h), Phi = a
;   weighted sum of guide-relevant progress groups.  Because F is
;   potential-based, the shaped MDP's optimal policy equals the game's for ANY
;   Phi and for the gamma the learner actually optimises -- so this redistributes
;   credit along a known-good route and cannot change what "good play" means.
;   It is NOT a scripted curriculum: no action is forced, the guide's ordering is
;   never required, and only the weights below (never a game rule) are tuned.
;   Phi covers a SUBSET of the guide: max HP, harvesting, luck, banked materials
;   (late waves only), 16 specific shop items, and the Pruner / Potato Thrower /
;   Excalibur weapons.  Guide items with no BT_RW_ITEM_IDX row (Crown, Coupon,
;   Dangerous Bunny, Lure, Sad Tomato/Torture, Bloody Hand) are paid only
;   indirectly, through the hp/harvest/luck groups and the base reward, and the
;   starting Ghost Scepter and its combines are paid only through the base
;   reward too.  Treat the shaping as a prior on the guide's economy and pivot,
;   not as an enforcer of its exact build.
;
; GUIDE SHAPING WEIGHTS (unchanged, evidence-backed; every one defaults to 0 and
; with all of them 0 the term is exactly 0.0f, so the reward stream is
; bit-identical to the unshaped game -- these are independent knobs, not a
; redefinition of the task).  Per-episode totals are exported as env/rw_total and
; env/rw_<group>.
;   rw_gamma MUST equal [train] gamma: the Ng et al. invariance holds for the
;   gamma the learner optimises, not for an arbitrary constant.
;   rw_hp 0.5     sqrt(max_hp) -- Demon's defence AND its shop currency.  sqrt
;                 (not log): both are concave, but sqrt is IEEE-correctly-rounded
;                 on host and device (bt_sqrtf == __fsqrt_rn) while device logf is
;                 not bit-identical to glibc's, which would break CPU/CUDA/Metal
;                 reward parity.  TENSION, not a bug: under hp_shop every purchase
;                 REMOVES max HP, so a large rw_hp pays the agent for NOT shopping
;                 while the guide's early game is "keep ~1 HP and abuse the HP
;                 shop"; keep it small (0.25-0.75) so it measures the mid/late Max
;                 HP engine without fighting the shop.
;   rw_harvest 0.5  stat_harvesting -- the guide's early economy engine.
;   rw_luck 0.5     stat_luck -- the guide's loot/box engine.
;   rw_items 0.5    fallback weight for each of the 16 counted items; an
;                   individual rw_item_<stem> key overrides it (e.g.
;                   rw_item_padding = 2.0).
;   rw_pivot 1.0    owned Pruner / Potato Thrower / Excalibur, credit (tier + 1)
;                   per owned copy.  UNCONDITIONAL: not wave-gated, and any
;                   owning action pays it as soon as the copy is held.
;   rw_materials 0.0 (with rw_late_wave = 20)  Banked materials, ON PURPOSE 0 for
;                   Demon: gold's only use here is the end-of-wave conversion
;                   into Max HP, which rw_hp already pays at the SAME transition.
;                   A linear materials term would double count it and, being
;                   linear while sqrt(max_hp) is concave, would swamp the hp
;                   credit (8 chunks = -65 gold = -3.25 shaping at 0.05 vs +1.0
;                   hp credit at 2.0) and so PUNISH the very conversion the guide
;                   farms.  Set a small nonzero value only if rw_hp is raised
;                   enough that the conversion stays net positive.
;   rw_wave_scale 0 NOT potential-based (it changes the incentive): 0 = off;
;                   R_WAVE * (1 + rw_wave_scale * max(0, wave-20)/10) per cleared
;                   wave otherwise.  Leave off unless the endless loop is being
;                   deliberately re-weighted.
;
; SIZING / ASSERTS for the 1B recipe below (re-derive, do not trust quotes):
;   sizeof(BtState) = 1,484,784 B (1.416 MiB) from build/brotato_state_size
;   sizes (2026-11-08); the CUDA env allocates exactly n*sizeof(Env)
;   (brotato.cu), so 4096 agents is ~5.8 GB of env state alone before the
;   trainer's buffers and CUDA graphs -- re-run that binary after any
;   StateCompact change before quoting an agent count.
;   Hard asserts: minibatch_size % horizon == 0; minibatch_size <=
;   horizon*total_agents; total_agents % (minibatch_size/horizon) == 0;
;   horizon % 8 == 0 for bf16.  With total_agents 4096 / horizon 128 /
;   minibatch_size 32768: 32768%128 == 0, 32768 <= 524288, 4096%256 == 0,
;   128%8 == 0.
;   [env] start_wave / warp_step / audio_rng can only be overridden on the CLI
;   when the key is present in the LOADED config ("missing key [env] ..."), which
;   is why audio_rng / invulnerable are declared here; start_wave and warp_step
;   are deliberately not (see [env]; tools/bench_trainer_make_deep_cwds.sh
;   declares them in the private bench cwds it generates).
;
; SMOKE BEFORE A LONG RUN (proves the loaded config really starts Demon; adapts
; nothing in source): the trainer dumps its effective merged config to
; <base.log_dir>/<env_name>/<run_id>.ini (pufferl.cu puf_ini_write), so
;   ./puffer train --headless --base.run_id=cfg_smoke --base.log_dir=/tmp/cfgsmoke/logs \
;       --base.checkpoint_dir=/tmp/cfgsmoke/ckpt --train.total_timesteps=524288
; and then
;   grep -E '^(character|starting_weapon|endless|invulnerable|gamma|rw_gamma|metric) ' \
;       /tmp/cfgsmoke/logs/brotato/cfg_smoke.ini
; must show character = demon, starting_weapon = weapon_ghost_scepter, endless = 1,
; invulnerable = 0, gamma = rw_gamma = 0.999 and metric = perf; start_wave is
; absent (its [env] key is not declared -- see above) so the run enters wave 1,
; and env/perf == env/endless_wave == 1 on the first frames.  A non-Demon config
; would instead resolve to Bull.  (524288 = 4096*128 = one epoch of transitions;
; use a throwaway run_id and a throwaway --base.checkpoint_dir/log_dir so the
; real run keeps its own directory and no other run's checkpoints are touched.)
; =============================================================================

[base]
env_name = brotato
eval_episodes = 16
eval_agents = 64

[env]
zone = 0
shop_steps = 1

; --- the profile: Demon + the guide's starting weapon ------------------------
; The weapon token is the canonical BT_WEAPONS id stem (brotato_weapons.h);
; "weapon_ghost_scepter" resolves to the tier-1 Ghost Scepter row
; (bt_weapon_index_from_id matches my_id first, then id, so the group token
; lands on the lowest tier).
character = demon
starting_weapon = weapon_ghost_scepter

; --- run options -------------------------------------------------------------
; Endless (run_data.gd:196-197 is_endless_run / the run-options toggle): 1 keeps
; the run going past the wave-20 clear instead of ending it, and the core then
; applies the endless enemy hp/dmg/speed scaling, shop/reroll inflation, iframe
; reduction, loot decay and the wave-10k elite reschedule.  Read with dict_find,
; so the key is optional.
endless = 1
; Starting wave (RunData.reset() `current_wave = DebugService.starting_wave`,
; run_data.gd:549): wave 1, the campaign boot.  NOT declared here on purpose --
; the core default IS 1 (bt_core_init sets s->start_wave = 1, brotato_core.h:2301,
; and bt_core_reset never clears it), and declaring it would silently break the
; generated bench cwds: tools/bench_trainer_make_deep_cwds.sh inserts its own
; `start_wave = N` right after [env] and strips only audio_rng / warp_step /
; invulnerable, while the ini parser lets a LATER duplicate key win (src/ini.h
; puf_ini_set -> dict_item reuses the first item and overwrites it), so a
; `start_wave = 1` here would override every deep cwd back to wave 1.  A config
; that wants a deeper start adds the key (the script does), which is also what
; makes --env.start_wave legal on the CLI: an override of a key the loaded config
; lacks is rejected ("missing key [env] start_wave", src/ini.h:400-411).
;
; Audio-RNG model: 0 = the bridge's audiovisual neutralization (sound
; queues/arrays cleared and exactly those draws do not happen), matching what
; the evaluation bridge records -- train and eval then share one model.  1 keeps
; the legacy source draws.
audio_rng = 0
; All CPUParticles2D emitters are likewise suppressed by the evaluation bridge.
particles_rng = 0
; DebugService.invulnerable (run_data.gd:556 -> player.gd:114-115
; disable_hurtbox): 1 disables the player's Hurtbox so no enemy contact or
; projectile registers a hit (no iframes/dodge draws/damage), while enemy
; AI/RNG/spawns are unchanged.  OFF for the task: with it on the hit/dodge/damage
; terms of the reward are inert, so a run would measure throughput, not play.
; It stays a declared key so the bench-only deep/sustained-crowd cwds
; (tools/bench_trainer_make_deep_cwds.sh) can pass --env.invulnerable=1.
invulnerable = 0

; --- guide-aligned potential-based shaping (see the header) ------------------
rw_gamma = 0.999
rw_hp = 0.5            ; Max-HP scaling: the guide's strongest build (sqrt(Max HP))
rw_harvest = 1.0       ; economy first: "invest heavily in Harvesting" (guide TL;DR)
rw_luck = 1.0          ; economy: Luck pays for crates/items and the guide's snowball
rw_materials = 0.0      ; deliberately OFF: this term pays for HOLDING materials, which
                        ; opposes the guide's "spend to snowball" -- spending is rewarded
                        ; through rw_items/rw_pivot instead
rw_late_wave = 20
rw_items = 0.75       ; buy the guide's items (and thin the pool with uniques)
rw_pivot = 1.0
rw_pivot_1 = weapon_pruner
rw_pivot_2 = weapon_potato_thrower
rw_pivot_3 = weapon_excalibur
rw_wave = 1            ; +1 for completing each wave (the requested objective)
rw_wave_scale = 0      ; 0 = flat +1 even past wave 20; raise to reward endless depth
; An individual item overrides the rw_items fallback for that stem, e.g.
;   rw_item_padding = 2.0
; (BT_RW_ITEM_IDX rows: padding, spicy_sauce, garden, improved_tools,
;  explosive_shells, plastic_explosive, alien_tongue, hunting_trophy,
;  tardigrade, anvil, alien_eyes, vigilante_ring, grinds_magical_leaf,
;  silver_bullet, bag, recycling_machine.)

; Sweep/best-checkpoint objective = env/perf = the wave reached (the game's own
; record: max_endless_wave_beaten.set_info(..., current_wave, ...), main.gd:944).
[sweep]
metric = perf

[vec]
; The 1B recipe: 6144 agents in one buffer (n*sizeof(Env) on the CUDA env), with
; the pre-existing Demon run's thread count.  total_agents 4096-7168 is the range
; that fits a 12 GiB card (measured: 4096 -> 7.1 GiB, 5120 -> 8.6, 6144 -> 10.0,
; 7168 -> 11.5; 8192 does not fit and pufferl.cu now refuses it up front with the
; largest fitting count instead of asserting).  At 6144 agents the same 1e9-step
; run takes 16m28s (vs 24m54s at 4096, SPS 871.8K vs 610.5K) and trains BETTER:
; perf 2.350 vs 1.905, score 55.350 vs 42.286, episode_return 56.625 vs 37.870,
; with 16 minibatches per epoch preserved (see minibatch_size below).
total_agents = 6144
num_buffers = 1
num_threads = 16

[policy]
hidden_size = 256
num_layers = 2

[train]
; Full Demon run: 1e9 env steps.
total_timesteps = 1_000_000_000
; Endless waves are long (60 s from wave 9, 90 s at 20) and the objective sits
; thousands of ticks away: 0.99 makes every wave/win term vanish
; (0.99^1200 ~ 5e-6).  1/(1-0.999) = 1000 ticks ~ 17 s of game time.
; rw_gamma above MUST equal this value.
gamma = 0.999
gae_lambda = 0.95
learning_rate = 0.001
; 4096 agents x 128 = 524288 transitions per epoch; 32768 = 16 minibatches/epoch
; (replay_ratio 1).  minibatch_size must stay a multiple of horizon, and
; minibatch_size/horizon (256 segments) must not exceed total_agents.
horizon = 128
; Scaled with total_agents so the number of minibatches per epoch is unchanged:
; 6144 agents x horizon 128 / 49152 = 16, exactly as 4096 x 128 / 32768 was.
minibatch_size = 49152
ent_coef = 0.02
[base]
env_name = None

# Multi-GPU (single GPU defaults)
gpu_offset = 0

profile = 0
# Metal: run the steering GEMMs in half precision with float32 masters.
mingru_fp16 = 0
checkpoint_dir = checkpoints
log_dir = logs
checkpoint_interval = 500
eval_episodes = 10000
eval_agents = -1
load_model_path = 'None'
load_enemy_model_path = 'None'
run_id = 'None'
result_fd = 0

# CUDA graphs (first real rollout/train use). >=0 enable, -1 disable.
cudagraphs = 1
seed = 73
# If true, zero RNN state every horizon (ablation). If false (default carry),
# state persists across horizons and resets only on terminal.
reset_every_horizon = 0

# Cleanba-style learner/actor pipelining: rollouts use a one-epoch-stale actor
# snapshot while the learner trains the previous horizon. Works with carry
# (reset_every_horizon=0) via per-slot initial_states.
async = 1

[vec]
total_agents = 4096
num_buffers = 2
num_threads = 8
# Total policies including trainable policies[0]. 1 = train only.
num_policies = 1
# Required > 0 when num_policies > 1 (historical opponent arch).
hist_policy_hidden_size = 0
hist_policy_num_layers = 0
# Fraction of envs (0â€“1) assigned to historical policies when num_policies > 1.
hist_policy_percent = 0

# Selfplay-pool training. When enabled, hist_policy_percent of agent slots (see
# [vec]) play against older checkpoints from the current run. Opponents are
# resampled from the pool every opp_timeout_steps global steps (0 = never).
# At end of train, final policy scoring (first match wins):
#   eval_bot_games > 0 â†’ mean env/perf vs the eval_bots ladder (1 Protein point)
#   else eval_games > 0 â†’ mean A winrate vs up to eval_pool_size pool opps
[selfplay]
enabled = 0
max_size = 16
seed = 42
# Resample each historical opponent after this many global steps. 0 = never.
opp_timeout_steps = 500_000_000
eval_pool_size = 8
eval_games = 0
# 0 = off. >0 = after train, eval final vs each bot in eval_bots for this many
# episodes each; mean env/perf becomes TrainResult.score (points=1 for Protein).
eval_bot_games = 0
# Ladder rungs, weakest first: the [env] bot_policy ids the env's header
# defines. Required when eval_bot_games > 0, e.g. eval_bots = 3,4,5,6.
eval_bots = 0
eval_bot_envs = 8192
eval_bot_threads = 0

# Per-rung [env] overrides for the bot ladder, as full section.key = value
# lines (e.g. env.dr = 0). Env-owned so core needs no per-env knowledge.
[bot_eval]

# Args used by your env's binding.c go here
[env]
dr = 0
num_agents = 1
num_bots = 0

[policy]
hidden_size = 128
num_layers = 4

[train]
gpus = 1
total_timesteps = 10_000_000
learning_rate = 0.015
anneal_lr = 1
min_lr_ratio = 0.0
gamma = 0.995
gae_lambda = 0.90
replay_ratio = 1.0
clip_coef = 0.2
vf_coef = 2.0
vf_clip_coef = 0.2
max_grad_norm = 1.5
ent_coef = 0.001
# Cosine-anneal ent_coef like lr does. Off by default (matches old behavior).
# When on: ent_coef decays from its base value to min_ent_coef_ratio * ent_coef
# over total_timesteps. Useful late in training to let a learned policy commit
# harder on its preferences once the entropy bonus is no longer load-bearing.
anneal_ent_coef = 0
min_ent_coef_ratio = 0.1
momentum = 0.95
minibatch_size = 8192
horizon = 64
# vtrace=0: GAE with Ï=1. vtrace=1: puff_advantage clips Ï/c.
vtrace = 0
vtrace_rho_clip = 1.0
vtrace_c_clip = 1.0

# Verb-eps exploration floor (experimental, Nethack; see src/algo.cu). 0 = off.
verb_eps = 0.0
verb_eps_anneal_start = 0.4
verb_eps_anneal_end = 1.0

[sweep]
metric = score 
metric_distribution = linear
goal = maximize
max_suggestion_cost = 3600
max_runs = 1200
gpus = -1
downsample = 5
prune_pareto = 1
early_stop_quantile = 0.3

[sweep.train.total_timesteps]
distribution = log_normal
min = 3e7
max = 1e11
scale = time

[sweep.policy.hidden_size]
distribution = uniform_pow2
min = 32
max = 1024
scale = auto

[sweep.policy.num_layers]
distribution = uniform
min = 1
max = 8
scale = auto

[sweep.vec.total_agents]
distribution = uniform_pow2
min = 256
max = 16384
scale = auto

#[sweep.vec.num_buffers]
#distribution = uniform
#min = 1
#max = 8
#scale = auto

[sweep.train.horizon]
distribution = uniform_pow2
min = 32
max = 512
scale = auto

[sweep.train.minibatch_size]
distribution = uniform_pow2
min = 4096
max = 65536
scale = auto

[sweep.train.learning_rate]
distribution = log_normal
min = 0.0001
max = 1.0
scale = 0.5

[sweep.train.ent_coef]
distribution = log_normal
min = 0.00001
max = 0.1
scale = auto

[sweep.train.gamma]
distribution = logit_normal
min = 0.8
max = 0.9999
scale = auto

[sweep.train.gae_lambda]
distribution = logit_normal
min = 0.2
max = 0.995
scale = auto

[sweep.train.replay_ratio]
distribution = uniform
min = 0.25
max = 4.0
scale = auto

# Lower clip is sometimes better but less stable
[sweep.train.clip_coef]
distribution = uniform
min = 0.1
max = 0.9
scale = auto

# Optimal vf clip can be lower than 0.1,
# but this results in jank unstable runs
[sweep.train.vf_clip_coef]
distribution = uniform
min = 0.01
max = 5.0
scale = auto

[sweep.train.vf_coef]
distribution = uniform
min = 0.1
max = 4.0
scale = auto

[sweep.train.max_grad_norm]
distribution = uniform
min = 0.1
max = 1.5
scale = auto

[sweep.train.momentum]
distribution = logit_normal
min = 0.5
max = 0.999
scale = auto
