[base]
env_name = bounce

[vec]
total_agents = 16384
num_buffers = 2
num_threads = 24

[env]
# Start level (0-10); rotation advances on portal, skipping sealed L8.
level = 0
# 1 = portal reloads the same level (strict L1 acceptance); 0 = advance rotation.
stay_level = 0
# 1 = multi-level episodes: portals advance without terminating; deaths/timeouts end them.
marathon = 0
# Spawn curve used as a curriculum. KEEP AT 0 under the ring-gated rules:
# the portal opens only when EVERY ring is collected, so biasing the spawn
# toward the portal strands the rings behind the ball (at bias 0.9 on L1,
# 5 of 6 rings are behind the spawn) and turns a forward task into a
# backtracking one. 0 = the real level spawn.
spawn_bias = 0
spawn_bias_min = 0
spawn_ladder_shift = 0
# Curriculum: rings already collected at level start (0 = none). Shrinks the
# fetch while keeping every remaining ring reachable (never strands one).
precollect = 0
# Reward scales (see ocean/bounce/bounce.h for the design rationale). Runtime
# tunable so the balance can be swept: PPO normalises advantages, so the RATIO
# between these matters, not the absolute scale.
r_ring = 1.0
r_prox = 0.01
r_goal = 10.0
r_dead = -2.0
# Per-step cost per uncollected ring. Rings gate the portal, so parking at a
# locked portal with one ring outstanding must be strictly worse than going
# back for it. Paid every step, so unlike a terminal penalty it survives the
# gamma^16000 discounting that makes the timeout charge negligible.
# DEFAULT 0: a 1B run from bounce_1b_final with 0.002 measured WORSE than the
# baseline (3/20 solved vs 6/20) and turned 14 timeouts into 13 hazard deaths.
# Left as a sweepable knob rather than deleted.
r_pending = 0.0
# Lives per episode (1 = single-life attempts; death ends the run, no penalty).
lives = 1
# Episode tick cap. A true-spawn L1 run that collects all 6 rings and exits
# fits well inside 4096 (the scripted reference driver completes in 780k-6.6M
# ticks because it is random; a trained policy does it in ~1-3k).
max_tick = 4096
# Strict L1 acceptance (single life, true spawn, no truncation of a real traverse):
#   train bounce env.level=0 env.stay_level=1 env.lives=1 env.max_tick=4096 \
#     env.spawn_bias=0 env.spawn_bias_min=0 env.spawn_ladder_shift=0
# REWARDS (settled by measurement, not by the docs' magnitude rule; only the
# RATIO matters to PPO because advantages are normalised):
#   goal   10.0  completing the level (collect every ring, then the portal)
#   rings   1.0  mandatory GATED subgoals (6 on L1). NOT farmable: the claimed
#                latch is never cleared for the life of a level instance, and a
#                death respawns via bounce_place(), which preserves rintaken[].
#                Only a full level load (bounce_load -> bounce_bind) restores
#                rings, and that happens only when a NEW episode starts, so
#                payouts cannot accumulate. Measured: placing the ball on ring 3
#                and dying repeatedly pays exactly once per episode (6 attempts
#                spanning 2 episodes -> 2 payouts, one per episode).
#                An earlier comment here claimed this was farmable and set 0.0;
#                that described a previous respawn design and is wrong.
#   shaping 0.01/px of NEW best progress toward the current subgoal (nearest
#                uncollected ring, else the portal), re-baselined on switch.
#                Monotone so it is unfarmable. Measured 45.11 total on a solve
#                (~74% of return), NOT the "<=1.0" an older note claimed. 0.003
#                stalls training outright; 0.01 is the measured sweet spot.
#   death/timeout -2.0 (equal: an unequal pair makes suicide-to-dodge-timeout
#                profitable). Note gamma^16000 ~ 3e-4 discounts this to almost
#                nothing at the tick cap, which is why the per-step r_pending
#                knob exists at all.
#
# GAMMA from the task horizon (~2000 steps for L1 with rings): the goal must stay
# worth more than the shaping budget at completion time. 0.999^2000*10 = 1.35
# (too tight), 0.9995^2000*10 = 3.68 (chosen), 0.9999 -> 8.19.
# GAE lambda 0.98 -> effective credit horizon 1/(1-gamma*lambda) = 49 steps
# (PufferLib's default 0.90/0.95 gives only 17-20, too short for a 2000-step goal).
#
# Recipe that worked pre-ring-gate (hot start, then commit by annealing entropy):
#   hot: train.lr=0.001-0.003 train.ent_coef=0.05
#   commit: + train.anneal_ent_coef=1 train.min_ent_coef_ratio=0.02-0.05
[policy]
hidden_size = 256
num_layers = 3

[train]
# Must lie inside [sweep.train.total_timesteps] -- the sweeper normalises this
# default into the sweep range and asserts if it falls outside.
total_timesteps = 1_000_000_000
learning_rate = 0.0003
anneal_lr = 1
gamma = 0.99
gae_lambda = 0.95
clip_coef = 0.2
vf_coef = 1.0
vf_clip_coef = 0.2
max_grad_norm = 1.0
ent_coef = 0.01
minibatch_size = 65536
horizon = 512

[sweep]
# --- objective -------------------------------------------------------------
# perf = fraction of episodes that actually CLEAR the level (all rings + portal).
# NOT score (inflatable by pumps/checkpoints without progress) and NOT progress
# (reaches a locked portal with rings missing and still scores ~1.0).
metric = perf
metric_distribution = linear
goal = maximize
# --- budget ----------------------------------------------------------------
# cost is the logged `uptime`, and total_timesteps is the cost index below, so
# the optimizer Pareto-trades competence against wall-clock.
max_runs = 300
gpus = -1
downsample = 5
use_gpu = True
prune_pareto = True
early_stop_quantile = 0.3
max_suggestion_cost = 3600

# ===========================================================================
# Spaces. default.ini already declares 16 params; these sections MERGE BY NAME
# (puf_ini_section(..., 1)), so only the ones needing constraint are repeated
# here. The rest keep default.ini's ranges.
# ===========================================================================

# PPO batch shape: the trainer asserts
#   minibatch_size % horizon == 0
#   minibatch_size <= horizon * total_agents
# Sampling these independently from default.ini's ranges aborts the run
# (minibatch 65536 vs horizon 32 x agents 256 = 8192). Constrained so every
# combination satisfies both: all three are powers of two, minibatch >= horizon
# so the modulus is always exact, and the smallest batch (128 x 2048 = 262144)
# still exceeds the largest minibatch.
[sweep.vec.total_agents]
distribution = uniform_pow2
min = 2048
max = 16384
scale = auto

[sweep.train.horizon]
distribution = uniform_pow2
min = 128
max = 1024
scale = auto

[sweep.train.minibatch_size]
distribution = uniform_pow2
min = 4096
max = 65536
scale = auto

# default.ini uses `uniform` here, which samples FRACTIONAL layer counts for an
# integer field.
[sweep.policy.num_layers]
distribution = int_uniform
min = 2
max = 4
scale = auto

# default.ini allows lr up to 1.0, which simply diverges PPO.
[sweep.train.learning_rate]
distribution = log_normal
min = 0.0001
max = 0.005
scale = 0.5

# --- task-specific: the reward RATIOS are what PPO cannot normalise away ----
[sweep.env.r_ring]
distribution = log_normal
min = 0.3
max = 3.0
scale = auto

[sweep.env.r_prox]
distribution = log_normal
min = 0.003
max = 0.05
scale = auto

[sweep.env.r_goal]
distribution = log_normal
min = 3.0
max = 30.0
scale = auto

# Death and timeout share r_dead in the env, so the invariant (death must not be
# cheaper than timing out) holds structurally however this is sampled.
[sweep.env.r_dead]
distribution = uniform
min = -5.0
max = 0.0
scale = auto

# 0 = off, so this must be a linear range that includes 0 (log_normal cannot).
[sweep.env.r_pending]
distribution = uniform
min = 0.0
max = 0.01
scale = auto

[sweep.env.max_tick]
distribution = uniform_pow2
min = 4096
max = 16384
scale = auto

# --- entropy commitment recipe (bounce-specific) ---------------------------
[sweep.train.anneal_ent_coef]
distribution = int_uniform
min = 0
max = 1
scale = auto

[sweep.train.min_ent_coef_ratio]
distribution = uniform
min = 0.01
max = 0.1
scale = auto

# --- run length: the cost axis. 5e8 is the floor that still solves L1. ------
[sweep.train.total_timesteps]
distribution = log_normal
min = 5e8
max = 3e9
scale = time
[base]
env_name = None

# Multi-GPU (single GPU defaults)
rank = 0
world_size = 1
gpu_id = 0
gpu_offset = 0
nccl_id = 'None'
profile = False
checkpoint_dir = checkpoints
log_dir = logs
checkpoint_interval = 500
eval_episodes = 10000
burnin_games = 0
eval_agents = -1
eval_greedy = False
load_model_path = 'None'
load_enemy_model_path = 'None'
run_id = 'None'
result_fd = 0
wandb = False
slowly = False
screenshot = 'None'
screenshot_steps = 0

# CUDA graphs (first real rollout/train use). >=0 enable, -1 disable.
cudagraphs = 1
seed = 73
# If true, zero RNN state every horizon (ablation). If false (default carry),
# state persists across horizons and resets only on terminal.
reset_every_horizon = 0

# Cleanba-style learner/actor pipelining: rollouts use a one-epoch-stale actor
# snapshot while the learner trains the previous horizon. Works with carry
# (reset_every_horizon=0) via per-slot initial_states.
async = 1

[vec]
total_agents = 4096
num_buffers = 2
num_threads = 16
# Total policies including trainable policies[0]. 1 = train only.
num_policies = 1
# Required > 0 when num_policies > 1 (historical opponent arch).
hist_policy_hidden_size = 0
hist_policy_num_layers = 0
# Fraction of envs (0â€“1) assigned to historical policies when num_policies > 1.
hist_policy_percent = 0
action_mask_size = 0
gpu_env = 0

# Selfplay-pool training. When enabled, hist_policy_percent of agent slots (see
# [vec]) play against older checkpoints from the current run. Opponents are
# resampled from the pool every opp_timeout_steps global steps (0 = never).
# At end of train, final policy is matched vs up to eval_pool_size opponents from
# the pool (mean A winrate becomes the sweep score when eval_games > 0).
[selfplay]
enabled = 0
max_size = 16
seed = 42
# Resample each historical opponent after this many global steps. 0 = never.
opp_timeout_steps = 500_000_000
eval_pool_size = 8
eval_games = 0
eval_agents = 8192

# Args used by your env's binding.c go here
[env]
dr = 0
num_agents = 1
num_bots = 0

[policy]
hidden_size = 128
num_layers = 4
expansion_factor = 1

[torch]
network = MinGRU
encoder = DefaultEncoder
decoder = DefaultDecoder

[train]
gpus = 1
seed = 42
total_timesteps = 10_000_000
learning_rate = 0.015
# Fraction of TRAINING steps that act greedily (argmax) instead of sampling.
# 0 = ordinary softmax sampling. Raising it trains the deterministic policy
# directly: a softmax policy can score well stochastically while its argmax is
# arbitrary, because PPO only ever optimises the sampled distribution.
greedy_p = 0
# Argmax fraction at the END of the run, with 1 = anneal linearly from
# greedy_p to greedy_p_end across training (explore early, commit late).
greedy_p_end = 0
greedy_anneal = 0
anneal_lr = 1
min_lr_ratio = 0.0
gamma = 0.995
gae_lambda = 0.90
replay_ratio = 1.0
clip_coef = 0.2
vf_coef = 2.0
vf_clip_coef = 0.2
max_grad_norm = 1.5
ent_coef = 0.001
# Cosine-anneal ent_coef like lr does. Off by default (matches old behavior).
# When on: ent_coef decays from its base value to min_ent_coef_ratio * ent_coef
# over total_timesteps. Useful late in training to let a learned policy commit
# harder on its preferences once the entropy bonus is no longer load-bearing.
anneal_ent_coef = 0
min_ent_coef_ratio = 0.1
momentum = 0.95
minibatch_size = 8192
horizon = 64
# vtrace=0: GAE with Ï=1. vtrace=1: puff_advantage clips Ï/c.
vtrace = 0
vtrace_rho_clip = 1.0
vtrace_c_clip = 1.0

# Verb-eps exploration floor (experimental, Nethack; see src/algo.cu). 0 = off.
verb_eps = 0.0
verb_eps_anneal_start = 0.4
verb_eps_anneal_end = 1.0

[sweep]
metric = score
metric_distribution = linear
goal = maximize
max_suggestion_cost = 3600
max_runs = 1200
gpus = -1
downsample = 5
use_gpu = True
prune_pareto = True
early_stop_quantile = 0.3

[sweep.train.total_timesteps]
distribution = log_normal
min = 3e7
max = 1e11
scale = time

[sweep.policy.hidden_size]
distribution = uniform_pow2
min = 32
max = 1024
scale = auto

[sweep.policy.num_layers]
distribution = uniform
min = 1
max = 8
scale = auto

[sweep.vec.total_agents]
distribution = uniform_pow2
min = 256
max = 16384
scale = auto

#[sweep.vec.num_buffers]
#distribution = uniform
#min = 1
#max = 8
#scale = auto

[sweep.train.horizon]
distribution = uniform_pow2
min = 32
max = 512
scale = auto

[sweep.train.minibatch_size]
distribution = uniform_pow2
min = 4096
max = 65536
scale = auto

[sweep.train.learning_rate]
distribution = log_normal
min = 0.0001
max = 1.0
scale = 0.5

[sweep.train.ent_coef]
distribution = log_normal
min = 0.00001
max = 0.1
scale = auto

[sweep.train.gamma]
distribution = logit_normal
min = 0.8
max = 0.9999
scale = auto

[sweep.train.gae_lambda]
distribution = logit_normal
min = 0.2
max = 0.995
scale = auto

[sweep.train.replay_ratio]
distribution = uniform
min = 0.25
max = 4.0
scale = auto

# Lower clip is sometimes better but less stable
[sweep.train.clip_coef]
distribution = uniform
min = 0.1
max = 0.9
scale = auto

# Optimal vf clip can be lower than 0.1,
# but this results in jank unstable runs
[sweep.train.vf_clip_coef]
distribution = uniform
min = 0.01
max = 5.0
scale = auto

[sweep.train.vf_coef]
distribution = uniform
min = 0.1
max = 4.0
scale = auto

[sweep.train.max_grad_norm]
distribution = uniform
min = 0.1
max = 1.5
scale = auto

[sweep.train.momentum]
distribution = logit_normal
min = 0.5
max = 0.999
scale = auto
