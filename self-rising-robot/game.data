[base]
env_name = None

# Multi-GPU (single GPU defaults)
gpu_offset = 0

profile = 0
checkpoint_dir = checkpoints
log_dir = logs
checkpoint_interval = 500
eval_episodes = 10000
eval_agents = -1
load_model_path = 'None'
load_enemy_model_path = 'None'
run_id = 'None'
result_fd = 0

# CUDA graphs (first real rollout/train use). >=0 enable, -1 disable.
cudagraphs = 1
seed = 73
# If true, zero RNN state every horizon (ablation). If false (default carry),
# state persists across horizons and resets only on terminal.
reset_every_horizon = 0

# Cleanba-style learner/actor pipelining: rollouts use a one-epoch-stale actor
# snapshot while the learner trains the previous horizon. Works with carry
# (reset_every_horizon=0) via per-slot initial_states.
async = 1

[vec]
total_agents = 4096
num_buffers = 2
num_threads = 8
# Total policies including trainable policies[0]. 1 = train only.
num_policies = 1
# Required > 0 when num_policies > 1 (historical opponent arch).
hist_policy_hidden_size = 0
hist_policy_num_layers = 0
# Fraction of envs (0â€“1) assigned to historical policies when num_policies > 1.
hist_policy_percent = 0

# Selfplay-pool training. When enabled, hist_policy_percent of agent slots (see
# [vec]) play against older checkpoints from the current run. Opponents are
# resampled from the pool every opp_timeout_steps global steps (0 = never).
# At end of train, final policy scoring (first match wins):
#   eval_bot_games > 0 â†’ mean env/perf vs the eval_bots ladder (1 Protein point)
#   else eval_games > 0 â†’ mean A winrate vs up to eval_pool_size pool opps
[selfplay]
enabled = 0
max_size = 16
seed = 42
# Resample each historical opponent after this many global steps. 0 = never.
opp_timeout_steps = 500_000_000
eval_pool_size = 8
eval_games = 0
# 0 = off. >0 = after train, eval final vs each bot in eval_bots for this many
# episodes each; mean env/perf becomes TrainResult.score (points=1 for Protein).
eval_bot_games = 0
# Ladder rungs, weakest first: the [env] bot_policy ids the env's header
# defines. Required when eval_bot_games > 0, e.g. eval_bots = 3,4,5,6.
eval_bots = 0
eval_bot_envs = 8192
eval_bot_threads = 0

# Per-rung [env] overrides for the bot ladder, as full section.key = value
# lines (e.g. env.dr = 0). Env-owned so core needs no per-env knowledge.
[bot_eval]

# Args used by your env's binding.c go here
[env]
dr = 0
num_agents = 1
num_bots = 0

[policy]
hidden_size = 128
num_layers = 4

[train]
gpus = 1
total_timesteps = 10_000_000
learning_rate = 0.015
anneal_lr = 1
min_lr_ratio = 0.0
gamma = 0.995
gae_lambda = 0.90
replay_ratio = 1.0
clip_coef = 0.2
vf_coef = 2.0
vf_clip_coef = 0.2
max_grad_norm = 1.5
ent_coef = 0.001
# Cosine-anneal ent_coef like lr does. Off by default (matches old behavior).
# When on: ent_coef decays from its base value to min_ent_coef_ratio * ent_coef
# over total_timesteps. Useful late in training to let a learned policy commit
# harder on its preferences once the entropy bonus is no longer load-bearing.
anneal_ent_coef = 0
min_ent_coef_ratio = 0.1
momentum = 0.95
minibatch_size = 8192
horizon = 64
# vtrace=0: GAE with Ï=1. vtrace=1: puff_advantage clips Ï/c.
vtrace = 0
vtrace_rho_clip = 1.0
vtrace_c_clip = 1.0

# Verb-eps exploration floor (experimental, Nethack; see src/algo.cu). 0 = off.
verb_eps = 0.0
verb_eps_anneal_start = 0.4
verb_eps_anneal_end = 1.0

[sweep]
metric = score 
metric_distribution = linear
goal = maximize
max_suggestion_cost = 3600
max_runs = 1200
gpus = -1
downsample = 5
prune_pareto = 1
early_stop_quantile = 0.3

[sweep.train.total_timesteps]
distribution = log_normal
min = 3e7
max = 1e11
scale = time

[sweep.policy.hidden_size]
distribution = uniform_pow2
min = 32
max = 1024
scale = auto

[sweep.policy.num_layers]
distribution = uniform
min = 1
max = 8
scale = auto

[sweep.vec.total_agents]
distribution = uniform_pow2
min = 256
max = 16384
scale = auto

#[sweep.vec.num_buffers]
#distribution = uniform
#min = 1
#max = 8
#scale = auto

[sweep.train.horizon]
distribution = uniform_pow2
min = 32
max = 512
scale = auto

[sweep.train.minibatch_size]
distribution = uniform_pow2
min = 4096
max = 65536
scale = auto

[sweep.train.learning_rate]
distribution = log_normal
min = 0.0001
max = 1.0
scale = 0.5

[sweep.train.ent_coef]
distribution = log_normal
min = 0.00001
max = 0.1
scale = auto

[sweep.train.gamma]
distribution = logit_normal
min = 0.8
max = 0.9999
scale = auto

[sweep.train.gae_lambda]
distribution = logit_normal
min = 0.2
max = 0.995
scale = auto

[sweep.train.replay_ratio]
distribution = uniform
min = 0.25
max = 4.0
scale = auto

# Lower clip is sometimes better but less stable
[sweep.train.clip_coef]
distribution = uniform
min = 0.1
max = 0.9
scale = auto

# Optimal vf clip can be lower than 0.1,
# but this results in jank unstable runs
[sweep.train.vf_clip_coef]
distribution = uniform
min = 0.01
max = 5.0
scale = auto

[sweep.train.vf_coef]
distribution = uniform
min = 0.1
max = 4.0
scale = auto

[sweep.train.max_grad_norm]
distribution = uniform
min = 0.1
max = 1.5
scale = auto

[sweep.train.momentum]
distribution = logit_normal
min = 0.5
max = 0.999
scale = auto
[base]
env_name = robo1
# Memoryless task: do not carry MinGRU state across horizons.
reset_every_horizon = 1
seed = 0

[vec]
total_agents = 2048
num_buffers = 2
num_threads = 24

[policy]
hidden_size = 64
num_layers = 2

[env]
# Author's reward terms (RL/robo1_env.py). Override per run, e.g.
#   --env.upright_const=0    (drop the constant offset that flattens advantages)
upright_const = 2.0
progress_coef = 8.0
goal_bonus = 5.0
cost_scale = 1.0
pose_tilt_scale = 1.0
# -1 = random fall pose each episode (training); 0..3 pins one pose (per-pose eval)
fixed_pose = -1
# 1 = author's behaviour (holding the goal 50 steps ends the episode). That makes the
# success cost future reward, so PPO learns to reach the goal and dodge the streak.
# 0 = never end on success; success is still logged as a 50-step hold.
terminate_on_success = 1
# Optional quiet-standing goal gate. 0 (default) = disabled: the original goal
# predicate. > 0 = a control step counts as goal_pose only if BOTH actual servo
# angular speeds are below this value in rad/s at the end of the control step.
# The quiet-standing runs use 0.1. Env-only knob (no reward term changes), so it
# can also be set per run with --env.goal_servo_speed_limit=0.1.
goal_servo_speed_limit = 0.0

[train]
total_timesteps = 20000000
# 0.005 was too hot (kl 0.24 / 18.9 in probes); sweep searches 1e-4..3e-3.
learning_rate = 0.001
# default.ini anneals from lr to min_lr_ratio*lr (=0); the annealed 100M run
# produced kl==0 for 762 epochs, so keep the LR fixed.
anneal_lr = 0
gamma = 0.99
gae_lambda = 0.95
replay_ratio = 1
clip_coef = 0.2
vf_coef = 0.5
vf_clip_coef = 1.0
max_grad_norm = 0.5
ent_coef = 0.001
momentum = 0.9
minibatch_size = 16384
horizon = 64

[sweep]
# `./puffer sweep` reads these. Small, high-signal search: optimizer/rollout knobs
# plus the reward shape (all env knobs are fields of ocean/robo1/robo1.h).
metric = perf
metric_distribution = linear
goal = maximize
max_runs = 12
gpus = 1

[sweep.train.total_timesteps]
distribution = int_uniform
min = 10000000
max = 30000000

[sweep.train.learning_rate]
distribution = log_normal
# lr=0.005 gave kl 0.24 (author reward) and kl 18.9 (curriculum): far too hot.
min = 0.0001
max = 0.003
scale = 0.5

[sweep.train.ent_coef]
distribution = log_normal
min = 0.0001
max = 0.01
scale = auto

[sweep.train.horizon]
distribution = uniform_pow2
min = 32
max = 256

[sweep.train.replay_ratio]
distribution = log_normal
min = 0.25
max = 4.0
scale = auto

[sweep.env.upright_const]
distribution = uniform
min = 0.0
max = 2.0
scale = 1.0

[sweep.env.cost_scale]
distribution = uniform
min = 0.1
max = 1.0
scale = 0.5

[sweep.env.pose_tilt_scale]
distribution = uniform
min = 0.5
max = 1.0
scale = 0.25

# Web-demo overlay for the browser build: preloaded as config/robo1_web.ini and
# loaded after config/robo1.ini (see puf_ini_load_env's PLATFORM_WEB branch).
#
# It pins the exact settings the published numbers were measured with, so the
# in-browser rollout is the CPU MuJoCo evaluation, not a re-tuned demo: the
# author's reward terms, full 90 deg falls, deterministic actions, and the
# episode ending at the 50-step goal hold.
[base]
env_name = robo1
# One-policy, memoryless task: MinGRU state is not carried across horizons.
reset_every_horizon = 1

[policy]
# MinGRU policy actually shipped in policies/1B_sparse_solved.bin; puffercpu's
# PufferNet builds exactly this shape and reads the weights from
# resources/robo1/robo1_weights.bin.
hidden_size = 64
num_layers = 2

[env]
upright_const = 2.0
progress_coef = 8.0
goal_bonus = 5.0
cost_scale = 1.0
pose_tilt_scale = 1.0
# 1 = episode ends once the goal pose has been held SUCCESS_STEPS (50) in a row,
# so the page restarts a get-up as soon as one succeeds (or at MAX_STEPS=700).
terminate_on_success = 1
goal_servo_speed_limit = 0.0
# -1 selects a random pose per episode; the web renderer (robo1_web_env.h)
# overrides this to cycle roll_pos, roll_neg, pitch_pos, pitch_neg so every
# canonical get-up is shown.
fixed_pose = -1
