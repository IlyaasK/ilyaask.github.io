©“=¼µ„½Õ>
©“=¼µ„½I¡>sN// robo1: 2-DoF get-up robot (SelfRisingRobot) as a PufferLib 5.0 CPU env.
//
// Physics is stock MuJoCo (C API), stepping in PufferLib's OMP worker threads, so
// the simulation is bit-for-bit the same model the repo's Python env trains on.
// Observation, action, reward and reset semantics mirror RL/robo1_env.py
// (Robo1GetupEnv) exactly, so a policy trained here is directly comparable to the
// shipped robo1_getup_ppo.zip.
//
// Env layout (required by PufferLib): Log log; Agent agents[NUM_AGENTS]; int tag;
// int boundary_reached; int num_agents; ... env state ...; unsigned int rng;
#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include <math.h>
#include <pthread.h>
#include <mujoco/mujoco.h>

// PufferLib action layout: continuous dims are declared as heads of size 1
// ("Continuous dims are size 1" in pufferl.cu). Two servo deltas -> two heads.
#define ACT_SIZES {1, 1}
#define OBS_SIZE 4
#define NUM_ATNS 2

typedef float obs_t;
#include "pufferenv.h"

#define FRAME_SKIP 20          // physics steps per control step (dt 0.001 -> 50 Hz)
#define MAX_STEPS 700
#define SETTLE_STEPS 200
#define TARGET_DELTA 0.08f
#define TARGET_LIMIT 1.55f
#define SUCCESS_STEPS 50       // consecutive goal_pose steps to finish an episode
#define N_POSES 4
#define START_Z 0.08

typedef struct Log Log;
struct Log {
    float perf;                // fraction of episodes that HELD goal_pose 50 steps (success)
    float episode_length;
    float success;             // same as perf: terminated by 50 consecutive goal_pose steps
    float touched;             // fraction that hit goal_pose at least once (diagnostic)
    float goal_step;           // steps spent in goal_pose, summed over episodes
    float best_upright;        // best upright per episode, summed (diagnostic)
    float n;
    float score;
};

struct Env {
    Log log;
    Agent agents[1];
    int tag;
    int boundary_reached;
    int num_agents;

    mjData* data;              // per-instance simulation state
    int foot_body;
    int s1_qpos, s2_qpos, s1_qvel, s2_qvel;
    float standing_height;

    float target[2];
    float prev_upright;
    int step_count;
    int success_count;
    int pose;                  // index into POSES
    float episode_return;
    int goal_reached;          // episode ever hit goal_pose
    int held;                  // goal_pose held SUCCESS_STEPS in a row at some point
    float best_upright;

    // Reward coefficients (author's defaults; overridable via [env] in the ini so
    // reward variants can be A/B tested without recompiling).
    float upright_const;       // 2.0 * upright
    float progress_coef;       // 8.0 * upright_progress
    float goal_bonus;          // +5.0 per goal_pose step
    float cost_scale;          // multiplier on all penalty terms
    float pose_tilt_scale;     // curriculum: fraction of the 90 deg fall angles
    int fixed_pose;            // -1: random fall pose per episode; 0..3: always this one
    // 1 (author): holding 50 steps ends the episode. That makes success cost future
    // reward (~+7/step while standing), so PPO learns to reach the pose and dodge the
    // streak (2.5x more discounted value at gamma 0.99). 0: never terminate on success;
    // success is still scored as a 50-step hold.
    int terminate_on_success;
    // Optional quiet-standing gate (config key goal_servo_speed_limit). 0 (default,
    // and also when the key is absent) = off: the original goal predicate. > 0: a
    // control step counts as goal_pose only if BOTH actual servo angular speeds are
    // below this value (rad/s) at the end of the control step, i.e. the joints are
    // not still moving between reward ticks. Every other goal/reward term is
    // unchanged.
    float goal_servo_speed_limit;

    unsigned int rng;
};
typedef Env Robo1;

// ---------------------------------------------------------------- model (shared)
// roll/pitch pairs of the four fallen starts, same order as FALLEN_POSES in the
// Python env: roll_pos, roll_neg, pitch_pos, pitch_neg.
static const float POSES[N_POSES][2] = {
    {1.57079632679f, 0.0f},
    {-1.57079632679f, 0.0f},
    {0.0f, 1.57079632679f},
    {0.0f, -1.57079632679f},
};

static mjModel* g_model = NULL;
static float g_standing_height = 0.0f;
static int g_foot_body = -1;
static int g_s1_qpos = -1, g_s2_qpos = -1, g_s1_qvel = -1, g_s2_qvel = -1;
static pthread_mutex_t g_model_lock = PTHREAD_MUTEX_INITIALIZER;

static const char* model_path(void) {
    const char* from_env = getenv("ROBO1_XML");
    if (from_env != NULL && from_env[0] != '\0') return from_env;
    static const char* candidates[] = {
        "ocean/robo1/robo1.xml",
        "robo1.xml",
        "../robo1.xml",
    };
    for (int i = 0; i < 3; i++) {
        FILE* f = fopen(candidates[i], "rb");
        if (f != NULL) {
            fclose(f);
            return candidates[i];
        }
    }
    return candidates[0];
}

static float foot_z(const mjModel* m, const mjData* d) {
    return (float)d->xpos[3*g_foot_body + 2];
}

// Mirrors Robo1GetupEnv._compute_standing_height: drop the robot into the settled
// upright pose and read the foot height.
static float compute_standing_height(const mjModel* m) {
    mjData* d = mj_makeData(m);
    memset(d->qpos, 0, m->nq * sizeof(mjtNum));
    memset(d->qvel, 0, m->nv * sizeof(mjtNum));
    d->qpos[0] = 0.0; d->qpos[1] = 0.0; d->qpos[2] = START_Z;
    d->qpos[3] = 1.0; d->qpos[4] = 0.0; d->qpos[5] = 0.0; d->qpos[6] = 0.0;
    for (int i = 0; i < m->nu; i++) d->ctrl[i] = 0.0;
    mj_forward((mjModel*)m, d);
    for (int i = 0; i < SETTLE_STEPS; i++) mj_step((mjModel*)m, d);
    float h = foot_z(m, d);
    mj_deleteData(d);
    return h;
}

static void ensure_model(void) {
    pthread_mutex_lock(&g_model_lock);
    if (g_model == NULL) {
        char err[2000] = "";
        const char* path = model_path();
        mjModel* m = mj_loadXML(path, NULL, err, sizeof(err));
        if (m == NULL) {
            fprintf(stderr, "robo1: failed to load %s: %s\n", path, err);
            pthread_mutex_unlock(&g_model_lock);
            exit(1);
        }
        g_foot_body = mj_name2id(m, mjOBJ_BODY, "foot");
        int j1 = mj_name2id(m, mjOBJ_JOINT, "servo1_joint");
        int j2 = mj_name2id(m, mjOBJ_JOINT, "servo2_joint");
        if (g_foot_body < 0 || j1 < 0 || j2 < 0) {
            fprintf(stderr, "robo1: model is missing foot/servo1_joint/servo2_joint\n");
            pthread_mutex_unlock(&g_model_lock);
            exit(1);
        }
        g_s1_qpos = m->jnt_qposadr[j1];
        g_s2_qpos = m->jnt_qposadr[j2];
        g_s1_qvel = m->jnt_dofadr[j1];
        g_s2_qvel = m->jnt_dofadr[j2];
        g_model = m;
        g_standing_height = compute_standing_height(m);
        fprintf(stderr, "robo1: loaded %s (nq=%ld nu=%ld standing_height=%.5f)\n",
                path, (long)m->nq, (long)m->nu, (double)g_standing_height);
    }
    pthread_mutex_unlock(&g_model_lock);
}

// ---------------------------------------------------------------- env internals
static float clipf(float v, float lo, float hi) {
    return v < lo ? lo : (v > hi ? hi : v);
}

static float upright_of(const mjData* d) {
    return (float)d->xmat[9*g_foot_body + 8];   // R[2][2] of the foot frame
}

static void write_obs(Robo1* env) {
    const mjtNum* q = env->data->qpos;
    double w = q[3], x = q[4], y = q[5], z = q[6];
    double sinr = 2.0*(w*x + y*z);
    double cosr = 1.0 - 2.0*(x*x + y*y);
    double roll = atan2(sinr, cosr);
    double sinp = 2.0*(w*y - z*x);
    sinp = sinp > 1.0 ? 1.0 : (sinp < -1.0 ? -1.0 : sinp);
    double pitch = asin(sinp);

    float* obs = env->agents[0].observations;
    obs[0] = (float)roll;
    obs[1] = (float)pitch;
    obs[2] = env->target[0];
    obs[3] = env->target[1];
}

static void add_log(Robo1* env) {
    env->log.perf += env->held ? 1.0f : 0.0f;
    env->log.episode_length += (float)env->step_count;
    env->log.success += env->held ? 1.0f : 0.0f;
    env->log.touched += env->goal_reached ? 1.0f : 0.0f;
    env->log.goal_step += (float)env->success_count;
    env->log.best_upright += env->best_upright;
    env->log.n += 1.0f;
}

void puf_reset(Robo1* env) {
    mjModel* m = g_model;
    mjData* d = env->data;

    env->pose = env->fixed_pose >= 0
        ? env->fixed_pose % N_POSES
        : (int)(rand_r(&env->rng) % (unsigned int)N_POSES);
    float roll = POSES[env->pose][0] * env->pose_tilt_scale;
    float pitch = POSES[env->pose][1] * env->pose_tilt_scale;

    // robo1_env.roll_pitch_to_quat
    double cr = cos(roll/2.0), sr = sin(roll/2.0);
    double cp = cos(pitch/2.0), sp = sin(pitch/2.0);

    memset(d->qpos, 0, m->nq * sizeof(mjtNum));
    memset(d->qvel, 0, m->nv * sizeof(mjtNum));
    d->qpos[0] = 0.0; d->qpos[1] = 0.0; d->qpos[2] = START_Z;
    d->qpos[3] = cr*cp;
    d->qpos[4] = sr*cp;
    d->qpos[5] = cr*sp;
    d->qpos[6] = -sr*sp;
    d->qpos[g_s1_qpos] = 0.0;
    d->qpos[g_s2_qpos] = 0.0;

    for (int i = 0; i < m->nu; i++) d->ctrl[i] = 0.0;
    mj_forward(m, d);
    for (int i = 0; i < SETTLE_STEPS; i++) {
        for (int a = 0; a < m->nu; a++) d->ctrl[a] = 0.0;
        mj_step(m, d);
    }

    env->target[0] = 0.0f;
    env->target[1] = 0.0f;
    for (int a = 0; a < m->nu; a++) d->ctrl[a] = 0.0;

    env->step_count = 0;
    env->success_count = 0;
    env->episode_return = 0.0f;
    env->goal_reached = 0;
    env->held = 0;
    env->prev_upright = upright_of(d);
    env->best_upright = env->prev_upright;

    write_obs(env);
}

void puf_step(Robo1* env) {
    mjModel* m = g_model;
    mjData* d = env->data;

    float a0 = clipf(env->agents[0].actions[0], -1.0f, 1.0f);
    float a1 = clipf(env->agents[0].actions[1], -1.0f, 1.0f);

    float old0 = env->target[0], old1 = env->target[1];
    env->target[0] = clipf(old0 + a0 * TARGET_DELTA, -TARGET_LIMIT, TARGET_LIMIT);
    env->target[1] = clipf(old1 + a1 * TARGET_DELTA, -TARGET_LIMIT, TARGET_LIMIT);

    for (int i = 0; i < FRAME_SKIP; i++) {
        d->ctrl[0] = (mjtNum)env->target[0];
        d->ctrl[1] = (mjtNum)env->target[1];
        mj_step(m, d);
    }

    env->step_count += 1;

    float roll, pitch;
    {
        float* obs = env->agents[0].observations;
        write_obs(env);
        roll = obs[0];
        pitch = obs[1];
    }

    float upright = upright_of(d);
    float upright_progress = upright - env->prev_upright;
    env->prev_upright = upright;

    float sa0 = (float)d->qpos[g_s1_qpos], sa1 = (float)d->qpos[g_s2_qpos];
    float sv0 = (float)d->qvel[g_s1_qvel], sv1 = (float)d->qvel[g_s2_qvel];
    float foot_height_error = foot_z(m, d) - g_standing_height;

    float tilt_cost = 0.2f * (roll*roll + pitch*pitch);
    float stand_gate = clipf((upright - 0.65f) / 0.35f, 0.0f, 1.0f);
    float servo_zero_cost = stand_gate * 0.5f * (sa0*sa0 + sa1*sa1);
    float target_zero_cost = stand_gate * 0.2f * (env->target[0]*env->target[0]
                                                + env->target[1]*env->target[1]);
    float height_cost = stand_gate * 5.0f * foot_height_error * foot_height_error;
    float body_velocity_cost = 0.0f;
    for (int i = 0; i < 6; i++) body_velocity_cost += (float)d->qvel[i] * (float)d->qvel[i];
    body_velocity_cost *= 0.01f;
    float servo_velocity_cost = 0.005f * (sv0*sv0 + sv1*sv1);
    float action_cost = 0.005f * (a0*a0 + a1*a1);
    float servo_motion_cost = 0.02f * ((env->target[0]-old0)*(env->target[0]-old0)
                                     + (env->target[1]-old1)*(env->target[1]-old1));

    float reward = env->upright_const * upright
                 + env->progress_coef * upright_progress
                 - env->cost_scale * (tilt_cost
                 + servo_zero_cost
                 + target_zero_cost
                 + height_cost
                 + body_velocity_cost
                 + servo_velocity_cost
                 + action_cost
                 + servo_motion_cost);

    float sa_max = fmaxf(fabsf(sa0), fabsf(sa1));
    float vnorm = 0.0f;
    for (int i = 0; i < 6; i++) vnorm += (float)d->qvel[i] * (float)d->qvel[i];
    vnorm = sqrtf(vnorm);

    int goal_pose = (upright > 0.95f
                     && fabsf(roll) < 0.25f
                     && fabsf(pitch) < 0.25f
                     && sa_max < 0.12f
                     && fabsf(foot_height_error) < 0.02f
                     && vnorm < 0.25f);
    if (env->goal_servo_speed_limit > 0.0f) {
        goal_pose = goal_pose
                 && fmaxf(fabsf(sv0), fabsf(sv1)) < env->goal_servo_speed_limit;
    }

    if (goal_pose) {
        env->success_count += 1;
        env->goal_reached = 1;
        reward += env->goal_bonus;
    } else {
        env->success_count = 0;
    }

    if (upright > env->best_upright) env->best_upright = upright;

    if (env->success_count >= SUCCESS_STEPS) env->held = 1;
    int terminated = env->terminate_on_success && env->held;
    int truncated = env->step_count >= MAX_STEPS;
    int done = terminated || truncated;

    env->episode_return += reward;
    env->agents[0].rewards[0] = reward;
    env->agents[0].terminals[0] = terminated ? 1.0f : 0.0f;

    if (done) {
        add_log(env);
        puf_reset(env);
    } else {
        write_obs(env);
    }
}

void puf_init(Robo1* env, Dict* kwargs) {
    env->num_agents = 1;
    ensure_model();
    env->data = mj_makeData(g_model);
    env->foot_body = g_foot_body;
    env->s1_qpos = g_s1_qpos;
    env->s2_qpos = g_s2_qpos;
    env->s1_qvel = g_s1_qvel;
    env->s2_qvel = g_s2_qvel;
    env->standing_height = g_standing_height;
    env->target[0] = 0.0f;
    env->target[1] = 0.0f;
    env->prev_upright = 0.0f;
    env->step_count = 0;
    env->success_count = 0;
    env->pose = 0;
    env->episode_return = 0.0f;
    env->goal_reached = 0;
    env->held = 0;
    env->best_upright = 0.0f;
    // Author's reward terms by default; see config/robo1.ini [env].
    env->upright_const = (float)dict_get(kwargs, "upright_const");
    env->progress_coef = (float)dict_get(kwargs, "progress_coef");
    env->goal_bonus = (float)dict_get(kwargs, "goal_bonus");
    env->cost_scale = (float)dict_get(kwargs, "cost_scale");
    env->pose_tilt_scale = (float)dict_get(kwargs, "pose_tilt_scale");
    env->fixed_pose = (int)dict_get(kwargs, "fixed_pose");
    env->terminate_on_success = (int)dict_get(kwargs, "terminate_on_success");
    // Optional: absent key (any config that predates it) leaves the original goal.
    DictItem* servo_limit = dict_find(kwargs, "goal_servo_speed_limit");
    env->goal_servo_speed_limit = servo_limit ? (float)servo_limit->value : 0.0f;
    memset(&env->log, 0, sizeof(Log));
}

void puf_close(Robo1* env) {
    if (env->data != NULL) {
        mj_deleteData(env->data);
        env->data = NULL;
    }
}

void puf_render(Robo1* env) {
    (void)env;   // trainer path only; use RL/play_robo1_policy.py for visualization
}

void puf_log(Log* log, Dict* out) {
    dict_set(out, "perf", log->perf);
    dict_set(out, "episode_length", log->episode_length);
    dict_set(out, "success", log->success);
    dict_set(out, "touched", log->touched);
    dict_set(out, "goal_step", log->goal_step);
    dict_set(out, "best_upright", log->best_upright);
    dict_set(out, "n", log->n);
    dict_set(out, "score", log->score);
}
<mujoco model="robo1">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"/>

  <asset>
    <mesh name="ATOM" file="ATOM.stl"/>
    <mesh name="foot" file="foot.stl"/>
    <mesh name="servo1" file="servo1.stl"/>
    <mesh name="arm1" file="arm1.stl"/>
    <mesh name="servo2" file="servo2.stl"/>
    <mesh name="arm2" file="arm2.stl"/>
  </asset>

  <default>
    <joint type="hinge" limited="true" range="-1.57079632679 1.57079632679"/>
    <position ctrllimited="true" ctrlrange="-1.57079632679 1.57079632679"
              forcelimited="true" forcerange="-1.0 1.0"
              kp="0.5" kv="0.04"/>
  </default>

  <worldbody>
    <light name="light1" pos="1 0 0" dir="0 0 -1" directional="true"/>
    <camera name="front" pos="0.22 -0.45 0.20" xyaxes="1 0 0 0 0.35 1"/>

    <body name="foot" pos="0 0 0.0">
      <joint type="free"/>
      <inertial pos="0.079759 -0.079713 0.078911" mass="0.017628"
                fullinertia="7.818e-6 5.908792e-6 1.1153122e-5 -4.3788e-8 -4.37317e-7 1.1931e-8"/>
      <geom type="mesh" mesh="foot" rgba="1 0.45 0.45 1"/>
      <geom name="foot_collision" type="box" pos="0.00829 0.00365 -0.00155"
            size="0.02131 0.03100 0.03748" contype="0" conaffinity="0" rgba="1 0.45 0.45 0"/>

      <body name="ATOM" pos="0 0 0">
        <inertial pos="0.07810 -0.10035 0.084206" mass="0.007"
                  diaginertia="4.34538e-7 4.34538e-7 6.40468e-7"/>
        <geom type="mesh" mesh="ATOM" rgba="1 1 1 1"/>
        <geom name="atom_collision" type="box" pos="0 0 0"
              size="0.00700 0.01180 0.01180" contype="0" conaffinity="0" rgba="1 1 1 0"/>
      </body>

      <body name="servo1" pos="0 0 0">
        <inertial pos="0.081005 -0.079 0.094111" mass="0.011"
                  fullinertia="6.54478e-7 1.01173e-6 6.17122e-7 -2.36801e-16 1.78456e-8 8.39085e-17"/>
        <geom type="mesh" mesh="servo1" rgba="0.5 0.5 0.5 1"/>
        <geom name="servo1_collision" type="box" pos="0 -0.00028 0.00036"
              size="0.00600 0.01570 0.01670" contype="0" conaffinity="0" rgba="0.5 0.5 0.5 0"/>  
      </body>


      <body name="arm1" pos="0 0 0">
        <joint name="servo1_joint" axis="1 0 0" pos="0.06070 -0.079 0.099606"
               damping="0.02" armature="0.0001"/>
        <inertial pos="0.077944 -0.07521 0.12069" mass="0.011444" 
                fullinertia="2.729019e-6 4.042083e-6 2.347159e-6 -1.3415e-8 -7.1469e-8 -5.00723e-7"/>
        <geom type="mesh" mesh="arm1" rgba="1 0.45 0.45 1"/>
        <geom name="arm1_collision" type="box" pos="0.00053 0.00003 0.00274"
              size="0.01366 0.02253 0.03257" contype="0" conaffinity="0" rgba="1 0.45 0.45 0"/>

        <body name="servo2" pos="0 0 0">
          <inertial pos="0.07810 -0.076095 0.139111" mass="0.011" 
                fullinertia="1.01173e-6 6.54478e-7 6.17122e-7 2.36801e-16 -8.39085e-17 1.78456e-8"/>
          <geom type="mesh" mesh="servo2" rgba="0.5 0.5 0.5 1"/>
          <geom name="servo2_collision" type="box" pos="0 0.00028 0.00036"
                size="0.00600 0.01570 0.01670" contype="0" conaffinity="0" rgba="0.5 0.5 0.5 0"/>  

          <body name="arm2" pos="0 0 0">
            <joint name="servo2_joint" axis="0 1 0" pos="0.07810 -0.09640 0.144606"
                   damping="0.02" armature="0.0001"/>
            <inertial pos="0.07810 -0.079112 0.189317" mass="0.021622" 
                    fullinertia="1.9417087e-5 1.7670681e-5 2.307976e-6 0 3.2e-11 -1.07968e-7"/>
            <geom type="mesh" mesh="arm2" rgba="1 0.45 0.45 1"/>
            <geom name="arm2_collision" type="box" pos="0 -0.00040 0.00975"
                  size="0.00625 0.02250 0.05202" contype="0" conaffinity="0" rgba="1 0.45 0.45 0"/>
          </body>

        </body>
      </body>

    </body>


    <geom name="ground_collision" type="plane" size="5 5 0.1" pos="0 0 0" rgba="0.0 0.5 0.0 0"/>
    <geom name="ground_visual" type="plane" size="5 5 0.1" pos="0 0 -0.008"
          contype="0" conaffinity="0" rgba="0.0 0.5 0.0 1"/>
  </worldbody>

  <actuator>
    <position name="servo1_pos" joint="servo1_joint"/>
    <position name="servo2_pos" joint="servo2_joint"/>
  </actuator>
</mujoco>
# Web build hook for the robo1 (self-rising robot) CPU MuJoCo env.
#
# Sourced by build.sh's --web branch (which is why this file exists only for
# robo1). It compiles the same src/puffercpu.c CPU-eval main as every other web
# env, but:
#   * the env header is experiments/web_demo/robo1_web_env.h, which pulls in
#     ocean/robo1/robo1.h plus the browser renderer in
#     experiments/web_demo/robo1_web_render.h;
#   * MuJoCo 3.16.0 is linked as an Emscripten static library built under
#     experiments/web_demo/mujoco (see experiments/web_demo/README.md);
#   * the MJCF (robo1.xml + STL meshes), configs and the 1B-step policy weights
#     are preloaded into the wasm filesystem, and the site bundle is copied to
#     experiments/web_demo/site (ROBO1_WEB_SITE_DIR to override; nothing is
#     published anywhere else).
set -e

WEB_DEMO_DIR="${ROBO1_WEB_DEMO_DIR:-$(cd .. && pwd)/experiments/web_demo}"
MUJOCO_WASM_DIR="${ROBO1_MUJOCO_WASM_DIR:-$WEB_DEMO_DIR/mujoco/build-wasm}"
WEIGHTS="${ROBO1_WEIGHTS:-$(cd ../.. && pwd)/policies/1B_sparse_solved.bin}"
SITE_DIR="${ROBO1_WEB_SITE_DIR:-$WEB_DEMO_DIR/site}"
ENV_HEADER_WEB="$WEB_DEMO_DIR/robo1_web_env.h"
BUILD_DIR="build/web/$ENV"

if [ ! -f "$MUJOCO_WASM_DIR/lib/libmujoco.a" ]; then
    echo "Error: $MUJOCO_WASM_DIR/lib/libmujoco.a missing; build MuJoCo for wasm first (see experiments/web_demo/README.md)" >&2
    exit 1
fi
if [ ! -f "$MUJOCO_WASM_DIR/lib/libccd.a" ]; then
    echo "Error: MuJoCo wasm dependencies missing in $MUJOCO_WASM_DIR/lib" >&2
    exit 1
fi
if [ ! -f "$WEIGHTS" ]; then
    echo "Error: policy weights $WEIGHTS missing" >&2
    exit 1
fi

mkdir -p "$BUILD_DIR" "$SITE_DIR"

PRELOAD=(
    --preload-file config/default.ini@config/default.ini
    --preload-file "config/$ENV.ini@config/$ENV.ini"
    --preload-file "$WEIGHTS@resources/$ENV/${ENV}_weights.bin"
    # MJCF + STL meshes; robo1.h resolves "ocean/robo1/robo1.xml" from the FS root.
    --preload-file "$SRC_DIR@$SRC_DIR"
)
if [ -f "$WEB_DEMO_DIR/config/${ENV}_web.ini" ]; then
    PRELOAD+=(--preload-file "$WEB_DEMO_DIR/config/${ENV}_web.ini@config/${ENV}_web.ini")
fi

echo "Compiling $ENV for web (MuJoCo wasm: $MUJOCO_WASM_DIR)..."
# Two steps: compile the C env with emcc, then link with em++ because the MuJoCo
# static library is C++ (XML parser + mesh decoders throw), so the link needs
# libc++ and real exception support (-fexceptions -> DISABLE_EXCEPTION_CATCHING=0).
COMMON_FLAGS=(
    -O3 -Wall -Wno-narrowing -Wno-unreachable-code
    -I. -Isrc -I"$SRC_DIR" -Ivendor
    -I"$WEB_DEMO_DIR/mujoco/include"
    "${INCLUDES[@]}"
    -DPLATFORM_WEB -DGRAPHICS_API_OPENGL_ES3
    -DPUFFERCPU_EVAL_MAIN
    -DENV_HEADER=\"$ENV_HEADER_WEB\"
    -DPUFFER_ENV_NAME=\"$ENV\"
    -DROBO1_WEB_DEBUG "${EXTRA_CFLAGS[@]}"
)
emcc -c src/puffercpu.c "${COMMON_FLAGS[@]}" -o "$BUILD_DIR/puffercpu.o"

em++ \
    -o "$BUILD_DIR/game.js" \
    "$BUILD_DIR/puffercpu.o" \
    "${LINK_ARCHIVES[@]}" \
    -L. -L./"$RAYLIB_NAME"/lib \
    -Wl,--whole-archive "$MUJOCO_WASM_DIR/lib/libmujoco.a" -Wl,--no-whole-archive \
    -Wl,--start-group \
    "$MUJOCO_WASM_DIR/lib/libccd.a" \
    "$MUJOCO_WASM_DIR/lib/libtinyxml2.a" \
    "$MUJOCO_WASM_DIR/lib/libtinyobjloader.a" \
    "$MUJOCO_WASM_DIR/lib/libminiz.a" \
    "$MUJOCO_WASM_DIR/lib/libqhullstatic_r.a" \
    -Wl,--end-group \
    -fexceptions \
    -sASSERTIONS=1 -sENVIRONMENT=web \
    -sUSE_GLFW=3 -sUSE_WEBGL2=1 -sASYNCIFY -sFILESYSTEM -sFORCE_FILESYSTEM=1 \
    --js-library vendor/puf_web_vsync.js \
    -sINITIAL_MEMORY=512MB -sALLOW_MEMORY_GROWTH -sSTACK_SIZE=512KB \
    "${PRELOAD[@]}"
echo "Built: $BUILD_DIR/game.js (+ game.wasm, game.data)"

cp -f "$BUILD_DIR/game.js" "$BUILD_DIR/game.wasm" "$BUILD_DIR/game.data" "$SITE_DIR/"
if [ ! -f "$SITE_DIR/index.html" ]; then
    echo "Warning: $SITE_DIR/index.html is missing (authored page)" >&2
fi
echo "Staged: $SITE_DIR"
ls -l "$SITE_DIR"
