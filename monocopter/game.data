[base]
env_name = None

# Multi-GPU (single GPU defaults)
gpu_offset = 0

profile = 0
checkpoint_dir = checkpoints
log_dir = logs
checkpoint_interval = 500
eval_episodes = 10000
eval_agents = -1
load_model_path = 'None'
load_enemy_model_path = 'None'
run_id = 'None'
result_fd = 0

# CUDA graphs (first real rollout/train use). >=0 enable, -1 disable.
cudagraphs = 1
seed = 73
# If true, zero RNN state every horizon (ablation). If false (default carry),
# state persists across horizons and resets only on terminal.
reset_every_horizon = 0

# Cleanba-style learner/actor pipelining: rollouts use a one-epoch-stale actor
# snapshot while the learner trains the previous horizon. Works with carry
# (reset_every_horizon=0) via per-slot initial_states.
async = 1

[vec]
total_agents = 4096
num_buffers = 2
num_threads = 8
# Total policies including trainable policies[0]. 1 = train only.
num_policies = 1
# Required > 0 when num_policies > 1 (historical opponent arch).
hist_policy_hidden_size = 0
hist_policy_num_layers = 0
# Fraction of envs (0â€“1) assigned to historical policies when num_policies > 1.
hist_policy_percent = 0

# Selfplay-pool training. When enabled, hist_policy_percent of agent slots (see
# [vec]) play against older checkpoints from the current run. Opponents are
# resampled from the pool every opp_timeout_steps global steps (0 = never).
# At end of train, final policy scoring (first match wins):
#   eval_bot_games > 0 â†’ mean env/perf vs the eval_bots ladder (1 Protein point)
#   else eval_games > 0 â†’ mean A winrate vs up to eval_pool_size pool opps
[selfplay]
enabled = 0
max_size = 16
seed = 42
# Resample each historical opponent after this many global steps. 0 = never.
opp_timeout_steps = 500_000_000
eval_pool_size = 8
eval_games = 0
# 0 = off. >0 = after train, eval final vs each bot in eval_bots for this many
# episodes each; mean env/perf becomes TrainResult.score (points=1 for Protein).
eval_bot_games = 0
# Ladder rungs, weakest first: the [env] bot_policy ids the env's header
# defines. Required when eval_bot_games > 0, e.g. eval_bots = 3,4,5,6.
eval_bots = 0
eval_bot_envs = 8192
eval_bot_threads = 0

# Per-rung [env] overrides for the bot ladder, as full section.key = value
# lines (e.g. env.dr = 0). Env-owned so core needs no per-env knowledge.
[bot_eval]

# Args used by your env's binding.c go here
[env]
dr = 0
num_agents = 1
num_bots = 0

[policy]
hidden_size = 128
num_layers = 4

[train]
gpus = 1
total_timesteps = 10_000_000
learning_rate = 0.015
anneal_lr = 1
min_lr_ratio = 0.0
gamma = 0.995
gae_lambda = 0.90
replay_ratio = 1.0
clip_coef = 0.2
vf_coef = 2.0
vf_clip_coef = 0.2
max_grad_norm = 1.5
ent_coef = 0.001
# Cosine-anneal ent_coef like lr does. Off by default (matches old behavior).
# When on: ent_coef decays from its base value to min_ent_coef_ratio * ent_coef
# over total_timesteps. Useful late in training to let a learned policy commit
# harder on its preferences once the entropy bonus is no longer load-bearing.
anneal_ent_coef = 0
min_ent_coef_ratio = 0.1
momentum = 0.95
minibatch_size = 8192
horizon = 64
# vtrace=0: GAE with Ï=1. vtrace=1: puff_advantage clips Ï/c.
vtrace = 0
vtrace_rho_clip = 1.0
vtrace_c_clip = 1.0

# Verb-eps exploration floor (experimental, Nethack; see src/algo.cu). 0 = off.
verb_eps = 0.0
verb_eps_anneal_start = 0.4
verb_eps_anneal_end = 1.0

[sweep]
metric = score 
metric_distribution = linear
goal = maximize
max_suggestion_cost = 3600
max_runs = 1200
gpus = -1
downsample = 5
prune_pareto = 1
early_stop_quantile = 0.3

[sweep.train.total_timesteps]
distribution = log_normal
min = 3e7
max = 1e11
scale = time

[sweep.policy.hidden_size]
distribution = uniform_pow2
min = 32
max = 1024
scale = auto

[sweep.policy.num_layers]
distribution = uniform
min = 1
max = 8
scale = auto

[sweep.vec.total_agents]
distribution = uniform_pow2
min = 256
max = 16384
scale = auto

#[sweep.vec.num_buffers]
#distribution = uniform
#min = 1
#max = 8
#scale = auto

[sweep.train.horizon]
distribution = uniform_pow2
min = 32
max = 512
scale = auto

[sweep.train.minibatch_size]
distribution = uniform_pow2
min = 4096
max = 65536
scale = auto

[sweep.train.learning_rate]
distribution = log_normal
min = 0.0001
max = 1.0
scale = 0.5

[sweep.train.ent_coef]
distribution = log_normal
min = 0.00001
max = 0.1
scale = auto

[sweep.train.gamma]
distribution = logit_normal
min = 0.8
max = 0.9999
scale = auto

[sweep.train.gae_lambda]
distribution = logit_normal
min = 0.2
max = 0.995
scale = auto

[sweep.train.replay_ratio]
distribution = uniform
min = 0.25
max = 4.0
scale = auto

# Lower clip is sometimes better but less stable
[sweep.train.clip_coef]
distribution = uniform
min = 0.1
max = 0.9
scale = auto

# Optimal vf clip can be lower than 0.1,
# but this results in jank unstable runs
[sweep.train.vf_clip_coef]
distribution = uniform
min = 0.01
max = 5.0
scale = auto

[sweep.train.vf_coef]
distribution = uniform
min = 0.1
max = 4.0
scale = auto

[sweep.train.max_grad_norm]
distribution = uniform
min = 0.1
max = 1.5
scale = auto

[sweep.train.momentum]
distribution = logit_normal
min = 0.5
max = 0.999
scale = auto
[base]
env_name = monocopter
# Synchronous actor: the drone env notes stale-actor rollouts hurt hover learning.
async = 0
# Carry MinGRU state across horizons so the policy can identify the
# randomized vehicle within an episode; it resets on terminal.
reset_every_horizon = 0

[vec]
total_agents = 8192
num_buffers = 4
num_threads = 16

[env]
num_drones = 64

# --- Hardware constants from jyjblrd's working configs -------------------
# moteus-mcout-working.cfg: mcout.throttle_max_velocity, cyclic_max_torque_Nm,
# servo.pid_position.kd (0.01) * mcout.kd_scale (2), servo.max_current_A,
# mcout.max_torque_Nm, mcout.accel_limit, motor.Kv, motor.resistance_ohm.
throttle_max_rev_s = 300
cyclic_max_nm = 0.15
kd_nm_per_rev_s = 0.02
max_current = 50
max_torque_nm = 25
accel_limit = 50000
kv = 1933.92
phase_resistance = 0.0403433

# --- UNMEASURED physics: sampled per episode from [min, max] -------------
# Replace with measurements as they arrive (weight, thrust-vs-RPM, cyclic tests).
mass_min = 0.30
mass_max = 0.60
ixx_min = 0.0004
ixx_max = 0.0016
izz_ratio_min = 0.8
izz_ratio_max = 1.6
rotor_inertia_min = 0.000015
rotor_inertia_max = 0.00008
# Rotor speed at hover (rev/s). 0.35 hover throttle * 300 = 105 would be the
# literal reading, but 0.35 is also ArduPilot's MOT_THST_HOVER default.
hover_rev_s_min = 110
hover_rev_s_max = 240
# Rotor drag torque / thrust (m): Q = torque_to_thrust * T.
torque_to_thrust_min = 0.008
torque_to_thrust_max = 0.02
# |body spin| at hover (rev/s), random direction; spin time constant (s).
spin_rev_s_min = 0.3
spin_rev_s_max = 4.0
spin_tau_min = 0.3
spin_tau_max = 3.0
# Body moment per N m of cyclic torque at hover speed.
cyc_gain_min = 0.1
cyc_gain_max = 0.6
cyc_speed_exp_min = -0.5
cyc_speed_exp_max = 1.0
# Residual error of the hand-tuned 0.27 rev cyclic_phase_offset (rev), and
# its drift per fractional speed change (moteus does not advance phase with speed).
cyc_phase_err_min = -0.05
cyc_phase_err_max = 0.05
cyc_phase_slope_min = -0.1
cyc_phase_slope_max = 0.1
# Thrust-tilt share of the cyclic moment and its lever arm (m).
cyc_arm_min = 0.03
cyc_arm_max = 0.12
cyc_tilt_frac_min = 0.2
cyc_tilt_frac_max = 1.0
# CoM offset moment as a fraction of full cyclic authority (MCOUT trims).
bias_frac_min = 0.0
bias_frac_max = 0.3
rate_damp_min = 0.0002
rate_damp_max = 0.004
lin_drag_min = 0.02
lin_drag_max = 0.2
kt_scale_min = 0.85
kt_scale_max = 1.15
# 4S pack under load; 13.2 V is the configured low-voltage warning.
vbus_min = 13.2
vbus_max = 16.8
# MCOUT/UART transport delay in control steps (truncated, max 4).
latency_min = 0
latency_max = 2.99

# 1/-1 fixes the rotor direction; 0 samples it.
spin_dir = 0
# 0: the 0.27 rev offset aligns the cyclic MOMENT with the command.
# 1: it also rotates by 90 deg so gyroscopic precession yields a RATE along it.
precession_compensated = 0

# --- Sensors (flight-controller side) ------------------------------------
# 1 (L1): EKF attitude + body-frame velocity/target offset.
# 2 (L2): raw gyro + accelerometer, IR beacon pulse, world-frame target
#         offset/velocity from an external position system; no EKF.
obs_level = 1
gyro_noise = 0.02
gyro_bias_max = 0.02
# ICM-42688 full scale: 2000 deg/s.
gyro_range = 34.9
att_noise = 0.005
att_bias_max = 0.02
# L2 accelerometer (m/s^2): per-sample noise after averaging, and bias.
accel_noise = 0.1
accel_bias_max = 0.2
# L2 probability that a beacon sweep produces no pulse.
beacon_miss = 0.05
pos_noise = 0.02
vel_noise = 0.05
vbus_noise = 0.05

# --- Task -----------------------------------------------------------------
# 1 kHz physics; 8 substeps = 125 Hz policy, below the ~137 Hz MCOUT frame
# rate 115200 baud allows. Change PUF_STEPS_PER_SEC for eval rendering too.
action_substeps = 8
horizon = 1000
# Spawn within target_dist of the target; terminate beyond max_dist or tilt_limit.
target_dist = 1.0
max_dist = 2.0
init_tilt_deg = 20
init_rate = 1.0
init_vel = 0.5
tilt_limit_deg = 60
alpha_hover = 0.15
alpha_dist = 0.7
alpha_action = 0.01
crash_penalty = 1.0

[policy]
# Small enough for flight-controller inference.
hidden_size = 64
num_layers = 2

[train]
# Starting point copied from config/drone.ini (tuned for the quadrotor).
momentum = 0.88409394
clip_coef = 0.32394895
ent_coef = 0.000127019011
gamma = 0.990013301
horizon = 64
learning_rate = 0.00867387839
max_grad_norm = 1.5
minibatch_size = 16384
replay_ratio = 3.97863984
total_timesteps = 150_000_000
vf_clip_coef = 4.14942741
vf_coef = 0.354031146

[sweep]
# perf scores distance/speed/rate only, so it stays comparable while the
# reward weights below are swept. Physics randomization ranges are NOT swept:
# narrowing them would raise perf without making the policy more robust.
metric = perf
max_runs = 100
# Seconds per trial (1B steps is ~330 s on the RTX 5070).
max_suggestion_cost = 1200

[sweep.train.total_timesteps]
min = 1e8
max = 2e9

# Keep the network small enough for flight-controller inference.
[sweep.policy.hidden_size]
min = 32
max = 256

[sweep.policy.num_layers]
min = 1
max = 4

[sweep.env.alpha_hover]
distribution = log_normal
min = 0.01
max = 1.0
scale = auto

[sweep.env.alpha_dist]
distribution = log_normal
min = 0.05
max = 3.0
scale = auto

[sweep.env.alpha_action]
distribution = log_normal
min = 0.0001
max = 0.1
scale = auto

[sweep.env.crash_penalty]
distribution = uniform
min = 0.0
max = 5.0
scale = auto
[env]
# Browser demo: fewer simultaneous drones keeps the frame rate up.
num_drones = 16
